<def-group>
  <definition class="compliance" id="nginx_installed" version="1">
    <metadata>
      <title>Ensure NGINX is installed</title>
      <affected family="unix">
        <platform>NGINX</platform>
      </affected>
      <description>NGINX must be installed on the system. The benchmark recommends version 1.28.0 or later.</description>
    </metadata>
    <criteria>
      <criterion comment="nginx package is installed" test_ref="test_nginx_installed" />
    </criteria>
  </definition>

  <linux:rpminfo_test check="all" check_existence="at_least_one_exists" comment="NGINX package is installed" id="test_nginx_installed" version="1">
    <linux:object object_ref="obj_nginx_installed" />
  </linux:rpminfo_test>
  <linux:rpminfo_object id="obj_nginx_installed" version="1">
    <linux:name>nginx</linux:name>
  </linux:rpminfo_object>

</def-group>
